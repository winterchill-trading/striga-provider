# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "banking-provider's Provider.S implemented over the Striga API"
description:
  "Adapter from the provider-neutral banking-provider interface to striga-client: customers and KYC, EUR and crypto accounts, SEPA, Lightning, on-chain and intraledger transfers with SCA, swaps, virtual cards, statements and webhooks normalized into banking-provider events. Sandbox by default."
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/striga-provider"
bug-reports: "https://github.com/winterchill-trading/striga-provider/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "async_kernel"
  "ppx_jane"
  "yojson"
  "zarith"
  "money"
  "ledger"
  "kyc-core"
  "payments-core"
  "card-core"
  "banking-provider"
  "striga-client"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/striga-provider.git"
