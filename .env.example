# Copy to .env (gitignored) and fill in from the Striga dashboard. Never commit real values.
# Sandbox base URL; the library refuses any other host unless ~live:true is passed.
STRIGA_BASE_URL=https://www.sandbox.striga.com/api/v1
STRIGA_API_KEY=
STRIGA_API_SECRET=
# Only needed by the browser-side card PAN UI component (StrigaUXPlugin.create).
STRIGA_APPLICATION_ID=
STRIGA_UI_SECRET=
# Set to 1 to let `dune test` run the conformance suite against the sandbox (creates sandbox users).
STRIGA_LIVE_TESTS=
